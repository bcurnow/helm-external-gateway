{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "fullnameOverride": {
      "type": "string"
    },
    "hostnames": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commonLabels": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "commonAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "apiVersions": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "gateway": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "gatewayClassName": {
          "type": "string"
        },
        "listeners": {
          "type": "array"
        },
        "defaultListener": {
          "type": "object",
          "properties": {
            "protocol": {
              "enum": [
                "HTTP",
                "HTTPS",
                "TLS",
                "TCP",
                "UDP"
              ]
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            },
            "secretName": {
              "type": "string"
            },
            "tls": {
              "type": "object"
            },
            "allowedRoutes": {
              "type": "object"
            }
          }
        }
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "HTTPRoute",
              "GRPCRoute",
              "TLSRoute",
              "TCPRoute",
              "UDPRoute"
            ]
          },
          "apiVersion": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "hostnames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "parentRefs": {
            "type": "array"
          },
          "rules": {
            "type": "array"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "labels": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "annotations": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "ports": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "port": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                "targetPort": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "protocol": {
                  "enum": [
                    "TCP",
                    "UDP",
                    "SCTP"
                  ]
                },
                "appProtocol": {
                  "type": "string"
                },
                "nodePort": {
                  "type": "integer"
                },
                "endpointPort": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                }
              },
              "required": [
                "port"
              ]
            }
          },
          "endpoints": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "addresses": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "minItems": 1
                }
              },
              "required": [
                "addresses"
              ]
            }
          },
          "endpointSlice": {
            "type": "object",
            "properties": {
              "nameIPv4": {
                "type": "string"
              },
              "nameIPv6": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          },
          "backendTLS": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "labels": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              },
              "annotations": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                }
              }
            }
          }
        },
        "required": [
          "name"
        ]
      }
    }
  }
}
